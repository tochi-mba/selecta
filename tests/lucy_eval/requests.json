    {"id": "follow-shorter", "kind": "follow-up", "turns": ["make a 1 hour dance mix", "actually make it 20 minutes"], "propose": true, "proposal_minutes": [12, 30]},
    {"id": "follow-swap", "kind": "follow-up", "turns": ["what's in my mix?", "swap Hello for something by Sade"], "propose": true, "proposal_kind": "change",
     "proposal_excludes": ["Hello"], "proposal_artists_any": ["Sade"]},
    {"id": "tempo", "kind": "honesty", "turns": ["what's the BPM of Latch?"], "propose": false,
