# Cloudflare Pages internal 200 proxies: keep /r/CODE visible in the address bar.
# Pages serves display.html at /display and kiosk.html at /kiosk by itself, and redirects the
# .html address to the clean one. A rewrite from /display to /display.html therefore loops
# (ERR_TOO_MANY_REDIRECTS), so those two have no rule here.
/r/:code /guest 200
/r/:code/ /guest 200
