# Cloudflare Pages internal 200 proxies: keep /r/CODE visible in the address bar.
# Rewrite to extensionless (canonical) Pages asset routes, NOT .html paths:
# Pages' automatic .html -> extensionless redirect otherwise loses the room code.
/display /display 200
/display/ /display 200
/kiosk /kiosk 200
/kiosk/ /kiosk 200
/r/:code /guest 200
/r/:code/ /guest 200
