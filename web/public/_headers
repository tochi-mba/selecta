# Response headers for the static site on Cloudflare Pages (the local app ignores this file).
# No page may be framed by another site (clickjacking of the host panel and the admin area),
# no plugins, no <base> from elsewhere, and no content-type sniffing.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
