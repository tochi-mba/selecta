# This repo is public. No audio, stems, caches or model weights, ever.
*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.opus
*.aiff
*.aif
*.wma
*.lrc

*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.th
*.bin

# Local data and outputs
/data/
/out/
/reels/
/.cache/
*.sqlite
*.sqlite3
*.db

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.json
htmlcov/
.ruff_cache/
*.egg-info/
build/
dist/

# Web
node_modules/
web/dist/
*.tsbuildinfo

# Browser and end-to-end test output
/.tmp-e2e/
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Tools and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.env
.env.*

# Local PostgreSQL for tests (docs/engineering/testing.md)
.pgdata/

# Temporary Git merge objects created by restricted-workspace tooling
_gitmerge*


# Test and tool output that must never be committed (any per-agent or per-run suffix)
**/test-results*/
**/playwright-report*/
**/blob-report*/
**/mp-results*/
**/mp-data*/
**/.playwright-artifacts*/
*.trace
*.trace.zip
trace.zip
*.network
*.log
.last-run.json
web/dist*/
!web/dist-cloud-e2e/.gitkeep

# Scratch and debugging files from agents: zz-* names, *-dbg / *_dbg specs and probe tests
**/zz-*
**/zz_*
**/*-dbg.*
**/*_dbg.*
tests/*_probe_test.py
web/e2e/*-probe.e2e.ts
web/e2e/*.probe.ts

# editor and tool scratch: atomic-write temp files (name.py.tmp.1234.abcd), swap, backup and merge leftovers
*.tmp
*.tmp.*
*.temp
*~
*.swp
*.swo
*.bak
*.orig
*.rej
.#*

# agents' before/after copies of the tree for timing comparisons (web/r8c-before/ etc.)
**/r[0-9]*-before/
**/r[0-9]*-after/
**/*-baseline-copy/
