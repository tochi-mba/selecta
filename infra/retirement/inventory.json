    },
    {
      "id": "r2-object-counts",
      "note": "Query live originals, derived, exports, staging, backups, historical versions and retention holds"
    },
    {
      "id": "signed-credentials",
      "note": "Inventory Render, Modal, Cloudflare, OIDC broker, worker bootstrap and legacy signing keys without revealing values"
    },
    {
      "id": "scheduled-work",
      "note": "Check Render original backup cron, autoscale leader, media GC, export sweeps and obsolete metrics"
    },
    {
      "id": "control-plane",
      "note": "Prove Render API, Postgres, WorkOS, Stripe, AI gateway, email, Pages/WAF, db backup and audit remain healthy"
    }
