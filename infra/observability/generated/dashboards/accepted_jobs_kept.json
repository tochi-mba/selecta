{
  "uid": "selecta-slo-accepted_jobs_kept",
  "title": "SLO: Zero lost accepted jobs",
  "tags": [
    "selecta",
    "slo"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "url": "https://github.com/tochi-mba/selecta/blob/main/docs/operations/slo-lost-jobs.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SLI (objective 99.999%)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(traces_spanmetrics_calls_total{service=\"selecta-api\", span_name=\"job.enqueue\"}[5m])) - sum(rate(selecta_invariant_violations_total{invariant=\"accepted_job_lost\"}[5m]))) / (sum(rate(traces_spanmetrics_calls_total{service=\"selecta-api\", span_name=\"job.enqueue\"}[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error budget left over 28d",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((1 - ((sum(rate(traces_spanmetrics_calls_total{service=\"selecta-api\", span_name=\"job.enqueue\"}[28d])) - sum(rate(selecta_invariant_violations_total{invariant=\"accepted_job_lost\"}[28d]))) / (sum(rate(traces_spanmetrics_calls_total{service=\"selecta-api\", span_name=\"job.enqueue\"}[28d]))))) / 1e-05)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate (1h and 6h)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "selecta:slo_error_ratio:1h{slo=\"accepted_jobs_kept\"} / 1e-05"
        }
      ]
    }
  ]
}
