{
  "uid": "selecta-slo-webhook_entitlement_latency",
  "title": "SLO: Webhook to entitlement p95 under 60 s",
  "tags": [
    "selecta",
    "slo"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "url": "https://github.com/tochi-mba/selecta/blob/main/docs/operations/slo-webhook-entitlement.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SLI (objective 95.000%)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(selecta_webhook_to_entitlement_seconds_bucket{le=\"60\"}[5m]))) / (sum(rate(selecta_webhook_to_entitlement_seconds_count[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error budget left over 28d",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((1 - ((sum(rate(selecta_webhook_to_entitlement_seconds_bucket{le=\"60\"}[28d]))) / (sum(rate(selecta_webhook_to_entitlement_seconds_count[28d]))))) / 0.05)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate (1h and 6h)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "selecta:slo_error_ratio:1h{slo=\"webhook_entitlement_latency\"} / 0.05"
        }
      ]
    }
  ]
}
